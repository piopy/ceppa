# ==========================================
# SECRETS DA CONFIGURARE SU HUGGING FACE SPACES (Settings -> Variables and secrets)
# ==========================================
# Obbligatori:
# - DATABASE_URL             (es. postgresql+asyncpg://user:pass@host:5432/dbname)
#
# Opzionali (o configurabili dall'utente via UI / profilo):
# - OPENAI_API_KEY           (opzionale: gli utenti possono inserirla dal loro profilo nell'app)
# - TAVILY_API_KEY           (opzionale: per la ricerca web, configurabile anche via UI)
# - LLM_MODEL                (default: gemini-3-flash-preview)
# - DEFAULT_LANGUAGE         (default: it)
# - MAX_CONCURRENT_WORKERS   (default: 3)
#
# NOTA: Postgres NON è embedded in questa immagine.
# Devi fornire un DATABASE_URL esterno (es. da un servizio Cloud SQL, Aiven, ecc.)
# oppure attivare il "Persistent Storage" di HF Spaces e configurare un container Postgres separato.
# ==========================================

# ==========================================
# STAGE 1: Build del Frontend (Vite/React)
# ==========================================
FROM node:20-alpine AS frontend-builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# ==========================================
# STAGE 2: Installa dipendenze Backend (Python)
# ==========================================
FROM python:3.10-slim-bookworm AS backend-deps

# Installa Pandoc, LaTeX e curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    pandoc \
    texlive-latex-base \
    texlive-fonts-recommended \
    texlive-xetex \
    lmodern \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Crea fontconfig cache directory con permessi adeguati
RUN mkdir -p /var/cache/fontconfig && chmod -R 777 /var/cache/fontconfig
ENV XDG_CACHE_HOME=/tmp/.cache

# Installa Poetry globalmente
ENV POETRY_HOME="/opt/poetry"
RUN curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

WORKDIR /app/backend
COPY backend/pyproject.toml backend/poetry.lock* ./
RUN poetry config virtualenvs.create false \
    && poetry install --no-root --no-interaction --no-ansi

# Copia il codice del backend
COPY backend/app ./app

# ==========================================
# STAGE 3: Immagine Finale (Python + FastAPI)
# ==========================================
FROM python:3.10-slim-bookworm

# Imposta la porta standard di Hugging Face
ENV PORT=7860

# Variabili d'ambiente di default (sovrascrivibili da HF Spaces secrets)
ENV LLM_MODEL=gemini-3-flash-preview \
    DEFAULT_LANGUAGE=it \
    MAX_CONCURRENT_WORKERS=3

# Installa solo curl (per healthcheck/debug)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Crea le directory necessarie con permessi per uid 1000 (HF Spaces non-root)
RUN mkdir -p /var/www/html /app && chown -R 1000:1000 /var/www/html /app

# Copia le dipendenze Python installate e il codice backend
COPY --from=backend-deps /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=backend-deps /app/backend /app/backend
COPY --from=backend-deps /usr/local/bin /usr/local/bin

# Ripristina i permessi su /app/backend dopo le COPY (che eseguono come root)
RUN chown -R 1000:1000 /app/backend

# Crea .env di default per pydantic-settings (senza DATABASE_URL — verrà passato via env)
# OPENAI_API_KEY è qui (file), NON come ENV Docker, così la libreria openai non la trova nel processo.
RUN printf 'OPENAI_API_KEY=dummy-key-to-prevent-startup-crash\nOPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/\n' > /app/backend/.env \
    && chown 1000:1000 /app/backend/.env

# Copia i file statici del frontend (serviti da FastAPI)
COPY --from=frontend-builder /app/dist /var/www/html

# Crea la directory necessaria ai PDF con i permessi corretti
RUN mkdir -p /app/user_files && chown -R 1000:1000 /app/user_files && chmod 777 /app/user_files

# Copia lo script di avvio
COPY scripts/start.sh /app/start.sh
RUN chown 1000:1000 /app/start.sh && chmod +x /app/start.sh

# Esponi la porta richiesta da HF Spaces
EXPOSE 7860

# Passa all'utente non-root richiesto da HF Spaces (uid 1000)
USER 1000

# Esegui lo script di avvio
CMD ["/app/start.sh"]